#!/bin/bash
# fence: PreToolUse hook, layer 3 of the team fences (docs/rules.md section 13).
#   allow  -> exit 0, no output
#   deny   -> JSON decision on stdout, exit 0
#   error  -> "[fence:<id>] reason" on stderr, exit 2 (internal-error, malformed-input, timeout)
# bash 3.2 + BSD tools, one jq call, no network. It never fails open: every unexpected exit
# becomes an error-deny through the EXIT trap, and a watchdog turns a slow decision into one.
# Rule semantics: hooks/README.md. Rule ids: docs/rules.md section 13.
LC_ALL=C
export LC_ALL
set -u
set -f
# Reasons go to fd 3 (the real stderr). bash's own notices (e.g. "Killed: 9" when the watchdog
# kills a child) go nowhere, so the first stderr line is always the fence's.
exec 3>&2 2>/dev/null
unset GLOBIGNORE

FENCE_DONE=0
FENCE_CHILD=0
FENCE_CHILD_PID=''
FENCE_AGENT=main
FENCE_TEXT=-
FENCE_WD=8
FENCE_WDPID=

# ============================================================ outcome, log, traps, watchdog

fence_redact() {
  # redact secrets in $1 into REPLY (one sed call, only on the deny path); at most 300 chars
  # only the start of the text is logged; cut first (substitution is slow on long text)
  local t=${1:0:2000}
  t=${t//$'\n'/ }
  t=${t//$'\t'/ }
  t=${t//$'\r'/ }
  t=${t//$'\001'/\$}
  REPLY=$(printf '%s\n' "$t" | sed -E \
    -e 's/(gh[opusr]_)[A-Za-z0-9_]+/\1[REDACTED]/g' \
    -e 's/github_pat_[A-Za-z0-9_]+/github_pat_[REDACTED]/g' \
    -e 's/([Bb][Ee][Aa][Rr][Ee][Rr])[ :]+[^ "'"'"']+/\1 [REDACTED]/g' \
    -e 's/([Aa]uthorization:[ ]*[A-Za-z]+[ ]+)[^ "'"'"']+/\1[REDACTED]/g' \
    -e 's/([A-Za-z0-9_]*([Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Kk][Ee][Yy])[A-Za-z0-9_]*=)("[^"]*"|'"'"'[^'"'"']*'"'"'|[^ ;&|]*)/\1[REDACTED]/g' \
    2>/dev/null) || REPLY='[redaction failed]'
  REPLY=${REPLY:0:300}
}

fence_log() {
  # one line per deny / error-deny: <UTC ISO-8601> TAB <rule-id> TAB <agent|main> TAB <text>
  local dir ts
  dir=${TEAM_CONFIG_DIR:-${HOME:-/nonexistent}/.config/team}
  [ -d "$dir" ] || return 0
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || ts=
  [ -n "$ts" ] || ts=unknown
  fence_redact "$FENCE_TEXT"
  printf '%s\t%s\t%s\t%s\n' "$ts" "$1" "$FENCE_AGENT" "$REPLY" >>"$dir/fence.log" 2>/dev/null
  return 0
}

fence_stop_watchdog() {
  # stop the watchdog and wait for it, so its sleep is gone before the hook exits
  if [ -n "$FENCE_WDPID" ] && [ "$FENCE_CHILD" = 0 ]; then
    kill -TERM "$FENCE_WDPID" 2>/dev/null
    wait "$FENCE_WDPID" 2>/dev/null
  fi
  FENCE_WDPID=''
  return 0
}

fence_error() {
  # fence_error <rule-id> <reason>: error-deny, exit 2
  FENCE_DONE=1
  trap '' ALRM
  fence_stop_watchdog
  printf '[fence:%s] %s\n' "$1" "$2" >&3
  fence_log "$1"
  exit 2
}

# shellcheck disable=SC2329 # invoked by the EXIT trap
fence_on_exit() {
  local st=$?
  if [ "$FENCE_DONE" != 1 ]; then
    FENCE_DONE=1
    trap '' ALRM
    fence_stop_watchdog
    printf '[fence:internal-error] the fence hook failed (status %s), so the call is blocked. Retry; if it keeps failing, tell the owner.\n' "$st" >&3
    fence_log internal-error
    exit 2
  fi
}

# shellcheck disable=SC2329 # invoked by the ALRM trap
fence_on_alarm() {
  # the watchdog fired: it kills the decision process (even inside a long builtin); wait
  # for that and for the watchdog itself, then fail closed
  trap '' ALRM
  [ -n "$FENCE_CHILD_PID" ] && wait "$FENCE_CHILD_PID" 2>/dev/null
  [ -n "$FENCE_WDPID" ] && wait "$FENCE_WDPID" 2>/dev/null
  FENCE_WDPID=''
  fence_error timeout "the fence hook ran out of time (${FENCE_WD}s), so the call is blocked. Retry with a simpler command."
}

trap fence_on_exit EXIT
trap fence_on_alarm ALRM

case ${TEAM_FENCE_WATCHDOG:-} in
  [1-8]) FENCE_WD=$TEAM_FENCE_WATCHDOG ;;
esac

deny() {
  # deny <rule-id> <reason>. Inside a scanned script or make recipe the id becomes script-scan.
  local id=$1 reason=$2 msg
  if [ -n "$F_SCAN_CTX" ] && [ "$id" != script-scan ]; then
    reason="$F_SCAN_CTX would run something the fence blocks ($id: $reason) Run the steps you need directly so each can be checked."
    id=script-scan
  fi
  FENCE_DONE=1
  trap '' ALRM
  fence_stop_watchdog
  msg="[fence:$id] ${reason:0:1500}"
  msg=${msg//\\/\\\\}
  msg=${msg//\"/\\\"}
  msg=${msg//$'\n'/ }
  msg=${msg//$'\t'/ }
  msg=${msg//$'\r'/ }
  msg=${msg//$'\001'/\$}
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$msg"
  fence_log "$id"
  exit 0
}

allow() {
  fence_stop_watchdog
  FENCE_DONE=1
  trap '' ALRM
  exit 0
}

fence_start_watchdog() {
  # A subshell sleeps FENCE_WD seconds, then signals the hook (ALRM) and kills every other
  # process under the hook (a hung git/jq or the test delay). Stopped early, it kills its sleep.
  (
    trap 'kill -TERM $! 2>/dev/null; exit 0' TERM
    sleep "$FENCE_WD" &
    wait $!
    trap '' TERM
    sleep 30 &
    marker=$!
    tree=$(ps -A -o pid= -o ppid= 2>/dev/null)
    kill -KILL "$marker" 2>/dev/null
    wait "$marker" 2>/dev/null
    kill -ALRM "$$" 2>/dev/null
    self=
    while read -r p pp; do
      [ "$p" = "$marker" ] && self=$pp
    done <<WDEOF
$tree
WDEOF
    list=" $$ "
    changed=1
    while [ "$changed" = 1 ]; do
      changed=0
      while read -r p pp; do
        [ -n "$p" ] || continue
        [ "$p" = "$self" ] && continue
        [ "$p" = "$marker" ] && continue
        case $list in *" $p "*) continue ;; esac
        case $list in *" $pp "*) list="$list$p " && changed=1 ;; esac
      done <<WDEOF
$tree
WDEOF
    done
    for p in $list; do
      [ "$p" = "$$" ] && continue
      kill -KILL "$p" 2>/dev/null
    done
    exit 0
  ) </dev/null >/dev/null 2>&1 3>&- &
  FENCE_WDPID=$!
}

