# ============================================================================ 6. env file
APP_URL=""
render_env_line() {
  local line=$1
  line=${line//'{{PORT}}'/$PORT}
  line=${line//'{{APP_URL}}'/$APP_URL}
  line=${line//'{{APP_TIMEZONE}}'/$TIMEZONE}
  line=${line//'{{DB_HOST}}'/$DB_HOST}
  line=${line//'{{DB_PORT}}'/$DB_PORT}
  line=${line//'{{DB_NAME}}'/$DB_NAME}
  line=${line//'{{DB_USER}}'/$DB_USER}
  line=${line//'{{DB_PASSWORD}}'/$DB_PASSWORD}
  while [[ $line == *'{{RANDOM_SECRET}}'* ]]; do
    line=${line/'{{RANDOM_SECRET}}'/$(openssl rand -hex 32)}
  done
  printf '%s\n' "$line"
}
step_env() {
  local tmpl=$OPS/env/$ENV_NAME.env.tmpl env_file=$APP_DIR/shared/.env line key missing=() have
  APP_URL="https://$HOST"; [[ $TLS == skip ]] && APP_URL="http://$HOST"
  if [[ ! -r $tmpl ]]; then
    team_warn "ops/env/$ENV_NAME.env.tmpl is missing; using the built-in minimal template"
    tmpl=$WORK/minimal.env.tmpl
    printf '%s\n' 'PORT={{PORT}}' 'APP_URL={{APP_URL}}' 'APP_TIMEZONE={{APP_TIMEZONE}}' > "$tmpl"
    [[ $DB_ENGINE == none ]] || printf '%s\n' 'DB_HOST={{DB_HOST}}' 'DB_PORT={{DB_PORT}}' 'DB_NAME={{DB_NAME}}' 'DB_USER={{DB_USER}}' 'DB_PASSWORD={{DB_PASSWORD}}' >> "$tmpl"
  fi
  if grep -Eo '\{\{[A-Za-z0-9_]+\}\}' "$tmpl" | grep -Evx '\{\{(PORT|APP_URL|APP_TIMEZONE|DB_HOST|DB_PORT|DB_NAME|DB_USER|DB_PASSWORD|RANDOM_SECRET)\}\}' >/dev/null; then
    team_warn "the env template has unknown {{…}} placeholders; they are left as written"
  fi
  if [[ ! -e $env_file ]]; then
    team_plan create "env file $env_file (600; $(team_env_keys "$tmpl" | wc -l | tr -d ' ') keys; secrets generated now, never printed)"
    if applying; then
      (umask 077
       while IFS= read -r line || [[ -n $line ]]; do render_env_line "${line%$'\r'}"; done < "$tmpl" > "$WORK/env")
      install -m 600 -o "$APP_USER" -g "$APP_USER" "$WORK/env" "$env_file"
    fi
    return 0
  fi
  have=$(team_env_keys "$env_file")
  while IFS= read -r key; do
    [[ -n $key ]] || continue
    grep -Fxq -- "$key" <<< "$have" || missing+=("$key")
  done < <(team_env_keys "$tmpl")
  if ((${#missing[@]})); then
    team_plan update "env file $env_file: append new template keys ${missing[*]} (existing values kept)"
    if applying; then
      (umask 077
       while IFS= read -r line || [[ -n $line ]]; do
         line=${line%$'\r'}
         [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)= ]] || continue
         for key in "${missing[@]}"; do [[ $key == "${BASH_REMATCH[2]}" ]] && render_env_line "$line"; done
       done < "$tmpl" > "$WORK/env-append")
      [[ -z $(tail -c 1 "$env_file") ]] || printf '\n' >> "$env_file"
      cat "$WORK/env-append" >> "$env_file"
    fi
  else
    team_plan ok "env file $env_file (existing values kept)"
  fi
  if [[ $(stat -c '%a %U %G' "$env_file") != "600 $APP_USER $APP_USER" ]]; then
    team_plan update "env file $env_file → $APP_USER 600"
    if applying; then chown "$APP_USER:$APP_USER" "$env_file"; chmod 600 "$env_file"; fi
  fi
  return 0
}

