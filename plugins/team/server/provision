# render_vhost <out file> <tls 0|1>
render_vhost() {
  local out=$1 tls=$2 v6="" conn root_line="" robots="" auth="" backend health_backend site_v=${SITE//-/_}
  [[ -s /proc/net/if_inet6 ]] && v6=1
  conn="\$${site_v}_connection"
  if [[ $ENV_NAME == staging ]]; then
    robots='    add_header X-Robots-Tag "noindex, nofollow" always;'
    auth=$(printf '    auth_basic "Staging";\n    auth_basic_user_file %s;' "$HTPASSWD")
  fi
  case $WEB_MODE in
    proxy)
      backend=$(cat <<EOF
        proxy_pass http://127.0.0.1:$PORT;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection $conn;
        proxy_read_timeout 60s;
EOF
)
      health_backend=$backend
      ;;
    static)
      root_line="    root $APP_DIR/current$([[ $STATIC_ROOT == . ]] || printf '/%s' "$STATIC_ROOT");"
      backend='        try_files $uri $uri/ =404;'
      health_backend='        try_files $uri =404;'
      ;;
    php-fpm)
      root_line="    root $APP_DIR/current$([[ $STATIC_ROOT == . ]] || printf '/%s' "$STATIC_ROOT");"$'\n'"    index index.php index.html;"
      backend='        try_files $uri $uri/ /index.php?$query_string;'
      health_backend=$(cat <<EOF
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME \$realpath_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT \$realpath_root;
        fastcgi_pass unix:$PHP_SOCK;
EOF
)
      ;;
  esac
  {
    printf '# team pack: %s %s (written by provision; do not edit, re-run provision instead)\n' "$PROJECT" "$ENV_NAME"
    if [[ $WEB_MODE == proxy ]]; then
      printf 'map $http_upgrade %s {\n    default upgrade;\n    %s close;\n}\n\n' "$conn" "''"
    fi
    if [[ $tls == 1 ]]; then
      printf 'server {\n    listen 80;\n'
      [[ -n $v6 ]] && printf '    listen [::]:80;\n'
      printf '    server_name %s;\n' "$HOST"
      [[ -n $robots ]] && printf '%s\n' "$robots"
      printf '    location ^~ /.well-known/acme-challenge/ {\n        root %s;\n        default_type text/plain;\n    }\n' "$TEAM_ACME_ROOT"
      printf '    location / {\n        return 301 https://$host$request_uri;\n    }\n}\n\n'
      printf 'server {\n    listen 443 ssl;\n'
      [[ -n $v6 ]] && printf '    listen [::]:443 ssl;\n'
      printf '    server_name %s;\n' "$HOST"
      printf '    ssl_certificate %s/fullchain.pem;\n    ssl_certificate_key %s/privkey.pem;\n    ssl_protocols TLSv1.2 TLSv1.3;\n' "$CERT_DIR" "$CERT_DIR"
    else
      printf 'server {\n    listen 80;\n'
      [[ -n $v6 ]] && printf '    listen [::]:80;\n'
      printf '    server_name %s;\n' "$HOST"
    fi
    printf '    access_log /var/log/nginx/%s.access.log;\n    error_log /var/log/nginx/%s.error.log;\n    client_max_body_size 25m;\n' "$SITE" "$SITE"
    [[ -n $root_line ]] && printf '%s\n' "$root_line"
    [[ -n $robots ]] && printf '%s\n' "$robots"
    [[ -n $auth ]] && printf '%s\n' "$auth"
    printf '\n    location ^~ /.well-known/acme-challenge/ {\n        root %s;\n        default_type text/plain;\n        auth_basic off;\n    }\n' "$TEAM_ACME_ROOT"
    printf '\n    # health check: no login, even on staging\n    location = %s {\n        auth_basic off;\n%s\n    }\n' "$HEALTH_PATH" "$health_backend"
    printf '\n    location / {\n%s\n    }\n' "$backend"
    if [[ $WEB_MODE == php-fpm ]]; then
      printf '\n    location ~ \\.php$ {\n        include snippets/fastcgi-php.conf;\n        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;\n        fastcgi_param DOCUMENT_ROOT $realpath_root;\n        fastcgi_pass unix:%s;\n    }\n' "$PHP_SOCK"
    fi
    printf '}\n'
  } > "$out"
  return 0
}

# shellcheck disable=SC2329  # called through install_checked
vhost_link_and_test() {
  [[ -L $NGINX_ENABLED ]] || ln -sfn "$NGINX_AVAIL" "$NGINX_ENABLED"
  nginx -t
}
# apply_vhost <rendered file> : install, enable, nginx -t, reload; the previous file is restored
# (and a new link removed) if nginx -t fails
apply_vhost() {
  local had_link=0
  [[ -L $NGINX_ENABLED ]] && had_link=1
  ledger_add nginx-link "$NGINX_ENABLED"
  if ! install_checked nginx "$NGINX_AVAIL" "$1" 644 root root vhost_link_and_test; then
    [[ $had_link == 1 ]] || rm -f -- "$NGINX_ENABLED"
    team_die "$TEAM_EXIT_FAIL" "nginx -t failed with the new vhost; the previous configuration was restored"
  fi
  team_service_reload nginx
  return 0
}

# acme_ready : nginx serves this host's ACME challenge folder (a reload takes effect a moment after
# it is requested; certbot must not race it)
acme_ready() {
  local dir=$TEAM_ACME_ROOT/.well-known/acme-challenge probe i
  install -d -m 755 -o root -g root "$TEAM_ACME_ROOT/.well-known" "$dir"
  probe=team-probe-$(openssl rand -hex 8)
  printf 'ok\n' > "$dir/$probe"
  chmod 644 "$dir/$probe"
  for ((i = 0; i < 40; i++)); do
    if curl -fsS -o /dev/null --max-time 2 -H "Host: $HOST" "http://127.0.0.1/.well-known/acme-challenge/$probe" 2>/dev/null; then
      rm -f -- "$dir/$probe"
      return 0
    fi
    sleep 0.25
  done
  rm -f -- "$dir/$probe"
  return 1
}

step_nginx() {
  local tls_final=0 need_cert=0
  if [[ -n $WEB_MANUAL ]]; then
    render_vhost "$WORK/vhost" 0
    team_plan skip "web server: $WEB_MANUAL. Add this config by hand (nginx syntax; adapt for your web server):"
    sed 's/^/    | /' "$WORK/vhost"
    return 0
  fi
  if [[ $TLS == on ]]; then
    tls_final=1
    [[ -r $CERT_DIR/fullchain.pem && -r $CERT_DIR/privkey.pem ]] || need_cert=1
  fi
  ensure_dir "$TEAM_ACME_ROOT" 755 root root
  if applying && ! nginx -t >"$WORK/nginx-pre.log" 2>&1; then
    sed 's/^/  nginx: /' "$WORK/nginx-pre.log" >&2
    team_die "$TEAM_EXIT_FAIL" "nginx -t already fails before any change; fix the existing configuration first"
  fi
  if [[ $TLS == skip ]]; then
    team_plan skip "TLS (TLS=skip in inputs.conf): HTTP only"
  elif (( need_cert )); then
    team_plan create "TLS certificate $CERT_NAME for $HOST (certbot webroot, non-interactive)"
    if applying; then
      if ! command -v certbot >/dev/null 2>&1; then
        team_plan create "package certbot"
        DEBIAN_FRONTEND=noninteractive apt-get install -y -q certbot >/dev/null
      fi
      render_vhost "$WORK/vhost-http" 0
      apply_vhost "$WORK/vhost-http"
      acme_ready || team_die "$TEAM_EXIT_FAIL" "nginx is not serving the ACME challenge path for $HOST (is nginx running?)"
      local -a certbot_args=(certonly --webroot -w "$TEAM_ACME_ROOT" -d "$HOST" --cert-name "$CERT_NAME"
        --non-interactive --agree-tos --keep-until-expiring --deploy-hook "systemctl reload nginx")
      if [[ -n $ACME_EMAIL ]]; then certbot_args+=(-m "$ACME_EMAIL"); else certbot_args+=(--register-unsafely-without-email); fi
      certbot "${certbot_args[@]}" || team_die "$TEAM_EXIT_FAIL" "certbot could not get a certificate for $HOST (does its DNS point at this server?)"
    fi
  else
    team_plan ok "TLS certificate $CERT_NAME"
  fi
  render_vhost "$WORK/vhost" "$tls_final"
  plan_file "$NGINX_AVAIL" "$WORK/vhost" 644 root root "nginx vhost $NGINX_AVAIL ($WEB_MODE$([[ $ENV_NAME == staging ]] && printf ', basic auth + noindex')$([[ $tls_final == 1 ]] && printf ', HTTPS'))"
  if [[ $CHANGED == 1 ]]; then
    applying && apply_vhost "$WORK/vhost"
  elif [[ ! -L $NGINX_ENABLED ]]; then
    team_plan create "nginx link $NGINX_ENABLED"
    if applying; then
      ledger_add nginx-link "$NGINX_ENABLED"
      ln -sfn "$NGINX_AVAIL" "$NGINX_ENABLED"
      apply_vhost "$NGINX_AVAIL"
    fi
  fi
  return 0
}

# ============================================================================ 8. services
# systemd_escape_cmd <command> : safe inside ExecStart=/bin/bash -c "…"
systemd_escape_cmd() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//%/%%}; s=${s//\$/\$\$}
  printf '%s' "$s"
}
db_unit() {
  case $DB_ENGINE in postgres) printf ' postgresql.service' ;; mariadb) printf ' mariadb.service' ;; mysql) printf ' mysql.service' ;; esac
}
UNITS_CHANGED=()
step_units() {
  local i unit file
  UNITS_CHANGED=()
  for i in "${!SVC_NAMES[@]}"; do
    unit=${UNITS[$i]}
    file=$WORK/$unit
    {
      printf '# team pack: %s %s service "%s" (from ops/services.conf; written by provision, do not edit)\n' "$PROJECT" "$ENV_NAME" "${SVC_NAMES[$i]}"
      printf '[Unit]\nDescription=team %s %s %s (%s)\nAfter=network-online.target%s\nWants=network-online.target\n\n' \
        "$PROJECT" "$ENV_NAME" "${SVC_NAMES[$i]}" "${SVC_TYPES[$i]}" "$(db_unit)"
      printf '[Service]\nType=simple\nUser=%s\nGroup=%s\nWorkingDirectory=%s/current\n' "$APP_USER" "$APP_USER" "$APP_DIR"
      printf 'Environment=TZ=UTC\n'
      [[ ${SVC_TYPES[$i]} == web ]] && printf 'Environment=PORT=%s\n' "$PORT"
      printf 'EnvironmentFile=%s/shared/.env\n' "$APP_DIR"
      printf 'ExecStart=/bin/bash -c "%s"\n' "$(systemd_escape_cmd "${SVC_CMDS[$i]}")"
      printf 'Restart=always\nRestartSec=3\nNoNewPrivileges=yes\nPrivateTmp=yes\n'
      printf 'StandardOutput=append:%s/%s.log\nStandardError=inherit\n\n' "$LOG_DIR" "${SVC_NAMES[$i]}"
      printf '[Install]\nWantedBy=multi-user.target\n'
    } > "$file"
    managed_file unit "$UNIT_DIR/$unit" "$file" 644 root root "systemd unit $unit (${SVC_TYPES[$i]}: ${SVC_CMDS[$i]})"
    [[ $CHANGED == 1 ]] && UNITS_CHANGED+=("$unit")
  done
  # services removed from ops/services.conf
  local old keep removed=()
  while IFS= read -r old; do
    [[ -n $old ]] || continue
    keep=0
    for unit in "${UNITS[@]}"; do [[ $old == "$UNIT_DIR/$unit" ]] && keep=1; done
    (( keep )) && continue
    if applying && team_systemd_running && [[ -e $old ]]; then systemctl disable --now "$(basename "$old")" >/dev/null 2>&1 || true; fi
    remove_managed unit "$old" "systemd unit $(basename "$old") (no longer in ops/services.conf)"
    removed+=("$old")
  done < <(team_ledger_list "$PROJECT" "$ENV_NAME" unit)
  if ((${#UNITS[@]} == 0)); then team_plan skip "no long-running services in ops/services.conf"; fi
  if ! team_systemd_running; then
    ((${#UNITS[@]} == 0)) || team_plan skip "systemd not running: unit files only, not enabled or started"
    return 0
  fi
  if applying && (( ${#UNITS_CHANGED[@]} + ${#removed[@]} > 0 )); then systemctl daemon-reload; fi
  for unit in "${UNITS[@]}"; do
    if [[ $(systemctl is-enabled "$unit" 2>/dev/null || true) == enabled ]]; then
      team_plan ok "enabled $unit"
    else
      team_plan update "enable $unit"
      applying && systemctl enable "$unit" >/dev/null
    fi
  done
  if [[ -L $APP_DIR/current ]]; then
    for unit in "${UNITS_CHANGED[@]}"; do
      team_plan update "restart $unit (unit changed)"
      if applying && ! systemctl restart "$unit"; then
        team_warn "$unit did not restart cleanly; see: journalctl -u $unit (the next deploy's health check decides)"
      fi
    done
  elif ((${#UNITS[@]})); then
    team_plan skip "services start with the first deploy (no release yet)"
  fi
  return 0
}

