#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
# provision — set up one project environment (<project>-<env>) on this server from a bundle that
# team-provision sends (docs/rules.md §12). Plan by default; changes only with --apply.
# shellcheck disable=SC2016  # nginx and systemd \$variables in single quotes are literal on purpose
set -Eeuo pipefail
TEAM_PROG=provision
TEAM_SELF_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# shellcheck source=lib.sh
. "$TEAM_SELF_DIR/lib.sh"

usage() {
  cat <<'EOF'
Usage: provision --bundle <dir> [--apply]

Sets up one environment of a project on this server, from <dir>/inputs.conf and <dir>/ops/:
  OS user and /srv/team/<project>/<env>/{releases,shared,current}; shared/.env from the template;
  app port (9100-9899); database and least-privilege database user; nginx vhost (proxy, php-fpm or
  static), TLS with certbot, basic auth + noindex on staging; systemd units from ops/services.conf
  and logrotate; the deploy key (forced command deploy-receive) and the narrow sudo rule;
  production only: nightly snapshot + backup and weekly backup --verify timers, and the db-pull
  key (forced command serve-snapshot). Installs the server scripts under /usr/local/lib/team/.

Prints a plan ([create] [update] [remove] [ok] [skip] lines) and changes nothing unless --apply.
Re-running applies changes made in ops/ and is otherwise a no-op. Refuses (exit 4) to reuse an OS
user, database, database user or nginx file the pack did not create. Run as root (sudo).
The last line is "TEAM-RESULT ok" or "TEAM-RESULT fail <reason>".

inputs.conf keys: PROJECT ENV HOST BASIC_AUTH_USER BASIC_AUTH_PASSWORD (staging) DEPLOY_PUBKEY
  DBPULL_PUBKEY (production) TIMEZONE LOW_TRAFFIC_HOUR ACME_EMAIL, and TLS=skip (tests only).

Exit codes: 0 ok, 1 failure, 2 usage, 4 refused, 5 missing prerequisite, 6 manual step needed.
EOF
}

for a in "$@"; do case $a in -h|--help) usage; exit 0 ;; esac; done

WORK=""
RESULT_ARMED=1
# shellcheck disable=SC2329  # invoked by the EXIT trap
on_exit() {
  local rc=$?
  [[ -n $WORK && -d $WORK ]] && rm -rf "${WORK:?}"
  if [[ $RESULT_ARMED == 1 ]]; then
    if (( rc == 0 )); then printf 'TEAM-RESULT ok\n'
    else printf 'TEAM-RESULT fail %s\n' "$(printf '%s' "${TEAM_FAIL_REASON:-exit $rc}" | tr '\n' ' ')"; fi
  fi
  exit "$rc"
}
trap on_exit EXIT
trap team_err_trap ERR

BUNDLE=""
while (($#)); do
  case $1 in
    --bundle) (($# >= 2)) || team_usage_error "--bundle needs a directory"; BUNDLE=$2; shift 2 ;;
    --bundle=*) BUNDLE=${1#*=}; shift ;;
    --apply) TEAM_APPLY=1; shift ;;
    *) team_usage_error "unknown argument '$1'" ;;
  esac
done
[[ -n $BUNDLE ]] || team_usage_error "--bundle <dir> is required"
[[ -d $BUNDLE ]] || team_usage_error "bundle directory not found: $BUNDLE"

applying() { [[ $TEAM_APPLY == 1 ]]; }
refuse() { team_die "$TEAM_EXIT_REFUSED" "refusing: $*"; }

team_require_root
team_os_check
team_require_cmd openssl install useradd getent runuser ss flock visudo sudo curl
WORK=$(mktemp -d)
team_flock provision 600

# ============================================================================ inputs
INPUTS=$BUNDLE/inputs.conf
OPS=$BUNDLE/ops
[[ -r $INPUTS ]] || team_die "$TEAM_EXIT_PREREQ" "missing $INPUTS"
[[ -r $OPS/project.conf ]] || team_die "$TEAM_EXIT_PREREQ" "missing $OPS/project.conf"
PCONF=$OPS/project.conf

PROJECT=$(team_conf_get "$INPUTS" PROJECT)
ENV_NAME=$(team_conf_get "$INPUTS" ENV)
HOST=$(team_conf_get "$INPUTS" HOST)
BASIC_AUTH_USER=$(team_conf_get "$INPUTS" BASIC_AUTH_USER)
BASIC_AUTH_PASSWORD=$(team_conf_get "$INPUTS" BASIC_AUTH_PASSWORD)
DEPLOY_PUBKEY=$(team_conf_get "$INPUTS" DEPLOY_PUBKEY)
DBPULL_PUBKEY=$(team_conf_get "$INPUTS" DBPULL_PUBKEY)
TIMEZONE=$(team_conf_get "$INPUTS" TIMEZONE "$(team_conf_get "$PCONF" PROJECT_TIMEZONE UTC)")
LOW_TRAFFIC_HOUR=$(team_conf_get "$INPUTS" LOW_TRAFFIC_HOUR "$(team_conf_get "$PCONF" LOW_TRAFFIC_HOUR 3)")
ACME_EMAIL=$(team_conf_get "$INPUTS" ACME_EMAIL)
TLS=$(team_conf_get "$INPUTS" TLS on)

PROJECT_NAME_CONF=$(team_conf_get "$PCONF" PROJECT_NAME)
DB_ENGINE=$(team_conf_get "$PCONF" DB_ENGINE none)
WEB_MODE=$(team_conf_get "$PCONF" WEB_MODE proxy)
HEALTH_PATH=$(team_conf_get "$PCONF" HEALTH_PATH /health)
MIGRATE_CMD=$(team_conf_get "$PCONF" MIGRATE_CMD)
SHARED_PATHS=$(team_conf_get "$PCONF" SHARED_PATHS)
STATIC_ROOT=$(team_conf_get "$PCONF" STATIC_ROOT public)

# ---------------------------------------------------------------------------- validation
team_check_project_env "$PROJECT" "$ENV_NAME"
[[ -z $PROJECT_NAME_CONF || $PROJECT_NAME_CONF == "$PROJECT" ]] \
  || team_usage_error "PROJECT ($PROJECT) does not match PROJECT_NAME in ops/project.conf ($PROJECT_NAME_CONF)"
[[ $HOST =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ && ${#HOST} -le 253 ]] \
  || team_usage_error "HOST must be a lowercase DNS name (got '$HOST')"
case $DB_ENGINE in postgres|mysql|mariadb|none) ;; *) team_usage_error "DB_ENGINE must be postgres, mysql, mariadb or none" ;; esac
case $WEB_MODE in proxy|php-fpm|static) ;; *) team_usage_error "WEB_MODE must be proxy, php-fpm or static" ;; esac
[[ $HEALTH_PATH =~ ^/[A-Za-z0-9._~/-]*$ ]] || team_usage_error "HEALTH_PATH must be a plain path such as /health"
[[ $STATIC_ROOT == . ]] || team_valid_relpath "$STATIC_ROOT" || team_usage_error "STATIC_ROOT must be a relative path inside the release"
for p in $SHARED_PATHS; do team_valid_relpath "$p" || team_usage_error "SHARED_PATHS entry '$p' must be a relative path"; done
[[ $TIMEZONE =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]] || team_usage_error "TIMEZONE must be an IANA name"
[[ -e /usr/share/zoneinfo/$TIMEZONE ]] || team_die "$TEAM_EXIT_PREREQ" "unknown timezone $TIMEZONE (is tzdata installed?)"
if ! [[ $LOW_TRAFFIC_HOUR =~ ^[0-9]{1,2}$ ]] || (( 10#$LOW_TRAFFIC_HOUR > 23 )); then team_usage_error "LOW_TRAFFIC_HOUR must be 0-23"; fi
LOW_TRAFFIC_HOUR=$(printf '%02d' "$((10#$LOW_TRAFFIC_HOUR))")
case $TLS in on|yes|true) TLS=on ;; skip|off|no) TLS=skip ;; *) team_usage_error "TLS must be on or skip" ;; esac
[[ -z $ACME_EMAIL || $ACME_EMAIL =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || team_usage_error "ACME_EMAIL is not an email address"
[[ $MIGRATE_CMD != *$'\n'* ]] || team_usage_error "MIGRATE_CMD must be one line"

# parse_pubkey <value> : prints "<type> <base64>" (the comment is replaced by ours)
parse_pubkey() {
  local t k rest
  read -r t k rest <<< "$1"
  : "$rest"
  [[ $t =~ ^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com)$ ]] || return 1
  [[ $k =~ ^[A-Za-z0-9+/]+=*$ ]] || return 1
  printf '%s %s' "$t" "$k"
}
[[ -n $DEPLOY_PUBKEY ]] || team_usage_error "DEPLOY_PUBKEY is missing in inputs.conf"
DEPLOY_KEY=$(parse_pubkey "$DEPLOY_PUBKEY") || team_usage_error "DEPLOY_PUBKEY is not an OpenSSH public key"
DBPULL_KEY=""
if [[ $ENV_NAME == production ]]; then
  [[ -n $DBPULL_PUBKEY ]] || team_usage_error "DBPULL_PUBKEY is missing in inputs.conf (production)"
  DBPULL_KEY=$(parse_pubkey "$DBPULL_PUBKEY") || team_usage_error "DBPULL_PUBKEY is not an OpenSSH public key"
fi
if [[ $ENV_NAME == staging ]]; then
  [[ $BASIC_AUTH_USER =~ ^[A-Za-z0-9._-]{1,64}$ ]] || team_usage_error "BASIC_AUTH_USER is missing or has odd characters (staging)"
  [[ -n $BASIC_AUTH_PASSWORD ]] || team_usage_error "BASIC_AUTH_PASSWORD is missing (staging)"
fi

# services.conf → SVC_NAMES / SVC_TYPES / SVC_CMDS
SVC_NAMES=(); SVC_TYPES=(); SVC_CMDS=()
if [[ -r $OPS/services.conf ]]; then
  n_line=0
  while IFS= read -r line || [[ -n $line ]]; do
    n_line=$((n_line + 1))
    line=$(team_trim "${line%$'\r'}")
    [[ -z $line || $line == '#'* ]] && continue
    IFS='|' read -r s_name s_type s_cmd <<< "$line"
    s_name=$(team_trim "$s_name"); s_type=$(team_trim "$s_type"); s_cmd=$(team_trim "$s_cmd")
    [[ $s_name =~ ^[a-z][a-z0-9-]{0,30}$ ]] || team_usage_error "ops/services.conf line $n_line: bad name '$s_name'"
    case $s_type in web|worker|scheduler) ;; *) team_usage_error "ops/services.conf line $n_line: type must be web, worker or scheduler" ;; esac
    [[ -n $s_cmd ]] || team_usage_error "ops/services.conf line $n_line: command is empty"
    for x in "${SVC_NAMES[@]}"; do [[ $x != "$s_name" ]] || team_usage_error "ops/services.conf: duplicate name $s_name"; done
    SVC_NAMES+=("$s_name"); SVC_TYPES+=("$s_type"); SVC_CMDS+=("$s_cmd")
  done < "$OPS/services.conf"
fi
web_count=0
for t in "${SVC_TYPES[@]}"; do [[ $t == web ]] && web_count=$((web_count + 1)); done
(( web_count <= 1 )) || team_usage_error "ops/services.conf: at most one web service (they share PORT)"

# ---------------------------------------------------------------------------- derived names
APP_USER=$(team_app_user "$PROJECT" "$ENV_NAME")
APP_DIR=$(team_app_dir "$PROJECT" "$ENV_NAME")
DB_NAME=$(team_db_ident "$PROJECT" "$ENV_NAME")
DB_USER=$DB_NAME
CONF_FILE=$(team_conf_file "$PROJECT" "$ENV_NAME")
SALT_FILE=$(team_salt_file "$PROJECT")
DBPASS_FILE=$(team_dbpass_file "$PROJECT" "$ENV_NAME")
SITE=team-$PROJECT-$ENV_NAME
NGINX_AVAIL=/etc/nginx/sites-available/$SITE.conf
NGINX_ENABLED=/etc/nginx/sites-enabled/$SITE.conf
HTPASSWD=$TEAM_NGINX_AUTH_DIR/$PROJECT-staging.htpasswd
SUDOERS=/etc/sudoers.d/$SITE
LOGROTATE=/etc/logrotate.d/$SITE
LOG_DIR=$TEAM_LOG_DIR/$PROJECT-$ENV_NAME
CERT_NAME=$SITE
CERT_DIR=/etc/letsencrypt/live/$CERT_NAME
UNIT_DIR=/etc/systemd/system
SYSTEMCTL=$(command -v systemctl || printf '/usr/bin/systemctl')
[[ $DB_ENGINE == none ]] && { DB_NAME=""; DB_USER=""; }

UNITS=()
for n in "${SVC_NAMES[@]}"; do UNITS+=("$SITE-$n.service"); done

PHP_VER="" POOL_FILE="" PHP_SOCK=""
if [[ $WEB_MODE == php-fpm ]]; then
  PHP_VER=$(team_php_fpm_version)
  [[ -n $PHP_VER ]] || team_die "$TEAM_EXIT_PREREQ" "WEB_MODE=php-fpm but php-fpm is not installed (apt-get install php-fpm)"
  POOL_FILE=/etc/php/$PHP_VER/fpm/pool.d/$SITE.conf
  PHP_SOCK=/run/php/$SITE.sock
fi

if [[ $DB_ENGINE != none ]]; then
  team_db_ready "$DB_ENGINE" || team_die "$TEAM_EXIT_PREREQ" "DB_ENGINE=$DB_ENGINE but its server is not installed or not answering as admin"
fi

WEB_MANUAL=""
if ! command -v nginx >/dev/null 2>&1; then
  WEB_MANUAL="nginx is not installed"
elif ! grep -Eqs '^[[:space:]]*include[[:space:]]+/etc/nginx/sites-enabled/' /etc/nginx/nginx.conf; then
  WEB_MANUAL="nginx does not include /etc/nginx/sites-enabled/"
fi

ledger_has() { team_ledger_has "$PROJECT" "$ENV_NAME" "$@"; }
ledger_add() { team_ledger_add "$PROJECT" "$ENV_NAME" "$@"; }

# ============================================================================ preflight (no changes)
for r in $TEAM_RESERVED_USERS; do [[ $APP_USER != "$r" ]] || refuse "$APP_USER is a reserved user name"; done
if getent passwd "$APP_USER" >/dev/null && ! ledger_has user "$APP_USER"; then
  refuse "OS user $APP_USER already exists and was not created by the team pack"
fi
if getent group "$APP_USER" >/dev/null && ! ledger_has user "$APP_USER"; then
  refuse "group $APP_USER already exists and was not created by the team pack"
fi
if [[ -e $APP_DIR || -L $APP_DIR ]] && ! ledger_has dir "$APP_DIR"; then
  refuse "$APP_DIR already exists and was not created by the team pack"
fi
if [[ $DB_ENGINE != none ]]; then
  if team_db_exists "$DB_ENGINE" "$DB_NAME" && ! ledger_has db "$DB_NAME"; then
    refuse "database $DB_NAME already exists and was not created by the team pack"
  fi
  if team_dbuser_exists "$DB_ENGINE" "$DB_USER" && ! ledger_has dbuser "$DB_USER"; then
    refuse "database user $DB_USER already exists and was not created by the team pack"
  fi
fi
check_foreign_file() { # <kind> <path>
  if [[ -e $2 || -L $2 ]] && ! ledger_has "$1" "$2"; then refuse "$2 already exists and was not created by the team pack"; fi
}
check_foreign_file nginx "$NGINX_AVAIL"
check_foreign_file nginx-link "$NGINX_ENABLED"
[[ $ENV_NAME == staging ]] && check_foreign_file htpasswd "$HTPASSWD"
[[ -n $POOL_FILE ]] && check_foreign_file pool "$POOL_FILE"
check_foreign_file sudoers "$SUDOERS"
check_foreign_file logrotate "$LOGROTATE"
for u in "${UNITS[@]}"; do check_foreign_file unit "$UNIT_DIR/$u"; done
if [[ $ENV_NAME == production ]]; then
  for j in snapshot backup backup-verify; do
    check_foreign_file timer "$UNIT_DIR/team-$PROJECT-$j.timer"
    check_foreign_file timer "$UNIT_DIR/team-$PROJECT-$j.service"
  done
fi
if [[ -z $WEB_MANUAL ]]; then
  other_server_names() {
    local f
    for f in /etc/nginx/sites-enabled/* /etc/nginx/conf.d/*.conf; do
      [[ -e $f ]] || continue
      [[ $(readlink -f "$f") == "$(readlink -f "$NGINX_AVAIL" 2>/dev/null || true)" ]] && continue
      sed 's/#.*//' "$f" | grep -oE '(^|[[:space:];{])server_name[[:space:]]+[^;]*' | sed -E 's/.*server_name[[:space:]]+//' || true
    done | tr -s ' \t' '\n' | sed '/^$/d'
  }
  if other_server_names | grep -Fxq -- "$HOST"; then
    refuse "another nginx site already serves $HOST"
  fi
fi

team_say "provision $PROJECT $ENV_NAME ($([[ $TEAM_APPLY == 1 ]] && echo apply || echo plan)) on $(team_conf_get /etc/os-release PRETTY_NAME unknown), $(team_utc_now)"

# ============================================================================ helpers
# file_state <path> <wanted file> <mode> <owner> <group> → create | update | ok
file_state() {
  if [[ ! -e $1 && ! -L $1 ]]; then echo create; return; fi
  if [[ -L $1 ]] || ! cmp -s "$1" "$2"; then echo update; return; fi
  if [[ $(stat -c '%a %U %G' "$1") != "$3 $4 $5" ]]; then echo update; return; fi
  echo ok
}
# install_file <path> <src> <mode> <owner> <group> : atomic replace
install_file() {
  local tmp
  tmp="$(dirname "$1")/.$(basename "$1").team-new.$$"
  install -m "$3" -o "$4" -g "$5" "$2" "$tmp"
  mv -fT "$tmp" "$1"
  return 0
}
# plan_file <path> <wanted file> <mode> <owner> <group> <label> : the plan line only; sets CHANGED
CHANGED=0
plan_file() {
  local state
  state=$(file_state "$1" "$2" "$3" "$4" "$5")
  CHANGED=0
  if [[ $state == ok ]]; then team_plan ok "$6"; return 0; fi
  team_plan "$state" "$6"
  CHANGED=1
  return 0
}
# managed_file <ledger kind> <path> <wanted file> <mode> <owner> <group> <label> : plan, and install
# with --apply; sets CHANGED
managed_file() {
  plan_file "$2" "$3" "$4" "$5" "$6" "$7"
  if [[ $CHANGED == 1 ]] && applying; then
    [[ -n $1 ]] && ledger_add "$1" "$2"
    install_file "$2" "$3" "$4" "$5" "$6"
  fi
  return 0
}
# install_checked <ledger kind> <path> <src> <mode> <owner> <group> <check command...> : install,
# run the check, and on failure put the previous file back (or remove the new one); returns 1
install_checked() {
  local kind=$1 path=$2 src=$3 mode=$4 owner=$5 group=$6 prev=""
  shift 6
  if [[ -e $path ]]; then prev=$WORK/prev.$RANDOM$RANDOM; cp -p "$path" "$prev"; fi
  [[ -n $kind ]] && ledger_add "$kind" "$path"
  install_file "$path" "$src" "$mode" "$owner" "$group"
  if "$@" > "$WORK/check.log" 2>&1; then return 0; fi
  if [[ -n $prev ]]; then install_file "$path" "$prev" "$mode" "$owner" "$group"; else rm -f -- "$path"; fi
  sed 's/^/  | /' "$WORK/check.log" >&2
  return 1
}
# ensure_dir <path> <mode> <owner> <group> [ledger kind]
ensure_dir() {
  if [[ ! -d $1 ]]; then
    team_plan create "directory $1 ($3:$4 $2)"
    if applying; then
      [[ -n ${5:-} ]] && ledger_add "$5" "$1"
      install -d -m "$2" -o "$3" -g "$4" "$1"
    fi
  elif [[ $(stat -c '%a %U %G' "$1") != "$2 $3 $4" ]]; then
    team_plan update "directory $1 → $3:$4 $2"
    if applying; then chown "$3:$4" "$1"; chmod "$2" "$1"; fi
  else
    team_plan ok "directory $1"
  fi
  return 0
}
# remove_managed <ledger kind> <path> <label> : only files this environment's ledger lists
remove_managed() {
  ledger_has "$1" "$2" || return 0
  if [[ -e $2 || -L $2 ]]; then
    team_plan remove "$3"
    applying && rm -f -- "$2"
  fi
  applying && team_ledger_remove "$PROJECT" "$ENV_NAME" "$1" "$2"
  return 0
}

# ============================================================================ 1. server scripts
step_scripts() {
  local f src dst changed=() state pii="" kind=update
  ensure_dir "$TEAM_LIB_DIR" 755 root root
  for f in $TEAM_SCRIPTS; do
    src=$TEAM_SELF_DIR/$f dst=$TEAM_LIB_DIR/$f
    [[ -r $src ]] || team_die "$TEAM_EXIT_PREREQ" "the bundle is missing $f"
    if [[ $src -ef $dst ]]; then state=$(file_state "$dst" "$dst" 755 root root); else state=$(file_state "$dst" "$src" 755 root root); fi
    if [[ $state != ok ]]; then
      changed+=("$f")
      [[ $state == create && ${#changed[@]} == 1 ]] && kind=create
      [[ $state == update ]] && kind=update
      if applying && ! [[ $src -ef $dst ]]; then install_file "$dst" "$src" 755 root root; fi
      if applying && [[ $src -ef $dst ]]; then chown root:root "$dst"; chmod 755 "$dst"; fi
    fi
  done
  if ((${#changed[@]})); then team_plan "$kind" "server scripts in $TEAM_LIB_DIR (root:root 755): ${changed[*]}"
  else team_plan ok "server scripts in $TEAM_LIB_DIR"; fi
  for f in "$BUNDLE/pii-patterns.txt" "$BUNDLE/config/pii-patterns.txt"; do [[ -r $f ]] && { pii=$f; break; }; done
  if [[ -n $pii && ! $pii -ef $TEAM_PII_FILE ]]; then
    managed_file "" "$TEAM_PII_FILE" "$pii" 644 root root "PII column patterns $TEAM_PII_FILE"
  fi
  return 0
}

# ============================================================================ 2. shared folders
step_base_dirs() {
  ensure_dir "$TEAM_ETC_DIR" 755 root root
  ensure_dir "$TEAM_PROJECTS_DIR" 755 root root
  ensure_dir "$TEAM_LOG_DIR" 755 root root
  ensure_dir "$TEAM_VAR_ROOT" 755 root root
  ensure_dir "$TEAM_VAR_ROOT/$PROJECT" 711 root root
  ensure_dir "$TEAM_SRV_ROOT" 755 root root
  ensure_dir "$TEAM_SRV_ROOT/$PROJECT" 755 root root
  return 0
}

# ============================================================================ 3. OS user and folders
step_user() {
  if getent passwd "$APP_USER" >/dev/null; then
    team_plan ok "OS user $APP_USER"
  else
    team_plan create "OS user $APP_USER (system user, home $APP_DIR, SSH key login only)"
    if applying; then
      ledger_add user "$APP_USER"
      useradd --system --user-group --home-dir "$APP_DIR" --no-create-home --shell /bin/bash \
        --password '*' --comment "team $PROJECT $ENV_NAME" "$APP_USER"
    fi
  fi
  return 0
}

step_app_dirs() {
  local mode=750 owner=$APP_USER
  # nginx (www-data) reads files directly in static and php-fpm modes
  [[ $WEB_MODE == proxy ]] || mode=755
  ensure_dir "$APP_DIR" "$mode" "$owner" "$owner" dir
  ensure_dir "$APP_DIR/releases" 755 "$owner" "$owner"
  ensure_dir "$APP_DIR/shared" 750 "$owner" "$owner"
  ensure_dir "$APP_DIR/.ssh" 755 root root
  ensure_dir "$LOG_DIR" 750 root "$owner"
  if [[ -L $APP_DIR/current ]]; then team_plan ok "current → $(basename "$(readlink "$APP_DIR/current")")"
  else team_plan skip "current: created by the first deploy"; fi
  if [[ $ENV_NAME == production ]]; then
    ensure_dir "$TEAM_VAR_ROOT/$PROJECT/backups" 700 root root
    ensure_dir "$TEAM_VAR_ROOT/$PROJECT/snapshots" 750 root "$owner"
  fi
  return 0
}

# ============================================================================ 4. port and project record
PORT=""
choose_port() {
  local existing p used assigned
  existing=$(team_conf_get "$CONF_FILE" PORT)
  if [[ $existing =~ ^[0-9]+$ ]] && (( existing >= TEAM_PORT_MIN && existing <= TEAM_PORT_MAX )); then
    PORT=$existing; team_plan ok "app port $PORT"; return 0
  fi
  used=$(ss -ltnH 2>/dev/null | awk '{print $4}' | sed -E 's/.*:([0-9]+)$/\1/' | sort -u)
  assigned=$(find "$TEAM_PROJECTS_DIR" -maxdepth 1 -name '*.conf' -exec sed -n 's/^PORT=\([0-9]*\).*/\1/p' {} + 2>/dev/null | sort -u || true)
  for ((p = TEAM_PORT_MIN; p <= TEAM_PORT_MAX; p++)); do
    if ! grep -qx "$p" <<< "$used" && ! grep -qx "$p" <<< "$assigned"; then PORT=$p; break; fi
  done
  [[ -n $PORT ]] || team_die "$TEAM_EXIT_FAIL" "no free port in $TEAM_PORT_MIN-$TEAM_PORT_MAX"
  team_plan create "app port $PORT (first free in $TEAM_PORT_MIN-$TEAM_PORT_MAX)"
  return 0
}

step_conf() {
  local f=$WORK/project.conf group=$APP_USER
  {
    printf '# team pack: %s %s (written by provision; do not edit, re-run provision instead)\n' "$PROJECT" "$ENV_NAME"
    printf 'PROJECT=%s\nENV=%s\nAPP_USER=%s\nAPP_DIR=%s\nPORT=%s\n' "$PROJECT" "$ENV_NAME" "$APP_USER" "$APP_DIR" "$PORT"
    printf 'HEALTH_PATH=%s\nMIGRATE_CMD=%s\nDB_ENGINE=%s\nDB_NAME=%s\nDB_USER=%s\n' "$HEALTH_PATH" "$MIGRATE_CMD" "$DB_ENGINE" "$DB_NAME" "$DB_USER"
    printf 'UNITS=%s\nWEB_MODE=%s\nHOST=%s\nTIMEZONE=%s\nLOW_TRAFFIC_HOUR=%s\n' "${UNITS[*]}" "$WEB_MODE" "$HOST" "$TIMEZONE" "$LOW_TRAFFIC_HOUR"
    printf 'SHARED_PATHS=%s\nSTATIC_ROOT=%s\n' "$SHARED_PATHS" "$STATIC_ROOT"
  } > "$f"
  managed_file "" "$CONF_FILE" "$f" 640 root "$group" "project record $CONF_FILE"
  return 0
}

step_salt() {
  if [[ -s $SALT_FILE ]]; then team_plan ok "anonymization salt $SALT_FILE"; return 0; fi
  team_plan create "anonymization salt $SALT_FILE (root 600, created once)"
  if applying; then
