# The sudo rule is checked three ways once installed: visudo -cf on the file; visudo -c on the whole
# configuration if that passed before the change (sudo-rs on Ubuntu 25.10+ ships /etc/sudoers 0644,
# which its visudo -c reports as an error although sudo-rs itself accepts it); and `sudo -l -U` must
# list every command, which proves the sudo in use (sudo or sudo-rs) really grants them.
SUDO_CMDS=() VISUDO_BASELINE=""
# shellcheck disable=SC2329  # called by sudoers_active
sudo_grants() { # <user> <command…>
  local user=$1 out c
  shift
  out=$(sudo -n -l -U "$user" 2>/dev/null | tr -s ' \t\n' ' ') || { echo "sudo -l -U $user failed"; return 1; }
  for c in "$@"; do
    [[ $out == *"$c"* ]] || { echo "sudo does not grant $user: $c"; return 1; }
  done
}
# shellcheck disable=SC2329  # called through install_checked
sudoers_active() {
  visudo -cf "$SUDOERS" || return 1
  if [[ $VISUDO_BASELINE == ok ]]; then visudo -c || return 1; fi
  sudo_grants "$APP_USER" "${SUDO_CMDS[@]}"
}

step_sudoers() {
  local cmds=() u i out=$WORK/sudoers
  for u in "${UNITS[@]}"; do cmds+=("$SYSTEMCTL reload-or-restart $u" "$SYSTEMCTL restart $u"); done
  [[ $WEB_MODE == php-fpm ]] && cmds+=("$SYSTEMCTL reload php$PHP_VER-fpm.service")
  [[ $ENV_NAME == production ]] && cmds+=("$TEAM_LIB_DIR/backup $PROJECT --pre-deploy")
  if ((${#cmds[@]} == 0)); then
    remove_managed sudoers "$SUDOERS" "sudo rule $SUDOERS (nothing left to allow)"
    team_plan skip "sudo rule (no services to reload)"
    return 0
  fi
  {
    printf '# team pack: %s %s — exactly what deploy-receive may run as root (written by provision; do not edit)\n' "$PROJECT" "$ENV_NAME"
    printf '%s ALL=(root) NOPASSWD: ' "$APP_USER"
    for i in "${!cmds[@]}"; do
      ((i == 0)) || printf ', \\\n    '
      printf '%s' "${cmds[$i]}"
    done
    printf '\n'
  } > "$out"
  chmod 440 "$out"
  visudo -cf "$out" >/dev/null || team_die "$TEAM_EXIT_FAIL" "the generated sudo rule does not pass visudo -c"
  plan_file "$SUDOERS" "$out" 440 root root "sudo rule $SUDOERS (${#cmds[@]} exact commands, validated with visudo -c)"
  if applying && [[ $CHANGED == 1 ]]; then
    SUDO_CMDS=("${cmds[@]}")
    if visudo -c > /dev/null 2>&1; then
      VISUDO_BASELINE=ok
    else
      VISUDO_BASELINE=fail
      team_warn "visudo -c already fails before this change ($(visudo -c 2>&1 | grep -v 'parsed OK' | head -n 1)); checking the new rule with visudo -cf and sudo -l instead"
    fi
    install_checked sudoers "$SUDOERS" "$out" 440 root root sudoers_active \
      || team_die "$TEAM_EXIT_FAIL" "sudoers did not validate with the new $SUDOERS; the previous rule was restored"
  fi
  return 0
}

# ============================================================================ 10. production timers
CAL="" CAL_NOTE=""
# calendar_spec <weekday|""> <HH> <MM> : OnCalendar in the project's timezone, or converted to
# server time when this systemd can't take a timezone (DST caveat noted).
calendar_spec() {
  local dow=$1 hh=$2 mm=$3 base ref u d h m epoch
  base="${dow:+$dow }*-*-* $hh:$mm:00"
  CAL_NOTE=""
  if [[ ${TEAM_TIMER_TZ_CONVERT:-0} != 1 ]] && command -v systemd-analyze >/dev/null 2>&1 \
     && systemd-analyze calendar "$base $TIMEZONE" >/dev/null 2>&1; then
    CAL="$base $TIMEZONE"
    return 0
  fi
  ref=$(TZ=$TIMEZONE date +%F)
  if [[ -n $dow ]]; then
    u=$(TZ=$TIMEZONE date -d "$ref" +%u)
    ref=$(date -d "$ref +$(( (7 - u) % 7 )) days" +%F)
  fi
  # The project-time moment as an epoch, shown in server time. (Not `date -d 'TZ="…" …'`: the Rust
  # coreutils date on Ubuntu 25.10+ silently ignores a TZ= inside -d.)
  epoch=$(TZ=$TIMEZONE date -d "$ref $hh:$mm" +%s)
  read -r d h m <<< "$(date -d "@$epoch" '+%a %H %M')"
  CAL="${dow:+$d }*-*-* $h:$m:00"
  CAL_NOTE="converted from ${dow:+$dow }$hh:$mm $TIMEZONE to server time on $(date -u +%F); a daylight-saving change in either zone shifts it by an hour until provision is re-run"
}
step_timers() {
  [[ $ENV_NAME == production ]] || return 0
  local job desc args dow mm name changed_timers=()
  for job in backup snapshot backup-verify; do
    case $job in
      backup)        desc="nightly production backup";             args="$PROJECT";          dow="";    mm=00 ;;
      snapshot)      desc="nightly sanitized snapshot";            args="$PROJECT";          dow="";    mm=20 ;;
      backup-verify) desc="weekly restore test of the newest backup"; args="$PROJECT --verify"; dow=Sun; mm=40 ;;
    esac
    name=team-$PROJECT-$job
    calendar_spec "$dow" "$LOW_TRAFFIC_HOUR" "$mm"
    {
      printf '# team pack: %s %s (written by provision; do not edit)\n' "$PROJECT" "$desc"
      printf '[Unit]\nDescription=team %s: %s\nAfter=network-online.target%s\n\n' "$PROJECT" "$desc" "$(db_unit)"
      printf '[Service]\nType=oneshot\nExecStart=%s/%s %s\nNice=10\nIOSchedulingClass=idle\n' "$TEAM_LIB_DIR" "${job%-verify}" "$args"
    } > "$WORK/$name.service"
    {
      printf '# team pack: %s %s at %s:%s %s (low-traffic hour; written by provision, do not edit)\n' "$PROJECT" "$desc" "$LOW_TRAFFIC_HOUR" "$mm" "$TIMEZONE"
      [[ -n $CAL_NOTE ]] && printf '# NOTE: %s\n' "$CAL_NOTE"
      printf '[Unit]\nDescription=team %s: %s\n\n[Timer]\nOnCalendar=%s\nPersistent=false\nAccuracySec=1min\n\n[Install]\nWantedBy=timers.target\n' "$PROJECT" "$desc" "$CAL"
    } > "$WORK/$name.timer"
    managed_file timer "$UNIT_DIR/$name.service" "$WORK/$name.service" 644 root root "systemd service $name.service ($TEAM_LIB_DIR/${job%-verify} $args)"
    [[ $CHANGED == 1 ]] && changed_timers+=("$name.timer")
    managed_file timer "$UNIT_DIR/$name.timer" "$WORK/$name.timer" 644 root root "timer $name.timer (OnCalendar=$CAL)"
    [[ $CHANGED == 1 ]] && changed_timers+=("$name.timer")
    [[ -n $CAL_NOTE ]] && team_plan note "$name.timer: $CAL_NOTE"
  done
  if ! team_systemd_running; then team_plan skip "systemd not running: timer files only, not enabled"; return 0; fi
  applying && ((${#changed_timers[@]})) && systemctl daemon-reload
  for job in backup snapshot backup-verify; do
    name=team-$PROJECT-$job.timer
    if [[ $(systemctl is-enabled "$name" 2>/dev/null || true) == enabled ]] && systemctl is-active -q "$name"; then
      if printf '%s\n' "${changed_timers[@]}" | grep -Fxq "$name"; then
        team_plan update "restart $name (schedule changed)"
        applying && systemctl restart "$name"
      else
        team_plan ok "enabled $name"
      fi
    else
      team_plan update "enable and start $name"
      applying && systemctl enable --now "$name" >/dev/null
    fi
  done
  return 0
}

