{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "dev-standards": {
      "source": {
        "source": "github",
        "repo": "akosiArvin081596/dev-standards",
        "ref": "v1"
      }
    }
  },
  "enabledPlugins": {
    "team@dev-standards": true
  },
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "autoMemoryEnabled": false,
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *release-please--*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push *--delete*)",
      "Bash(git *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git *core.hooksPath*)",
      "Bash(git *core.hookspath*)",
      "Bash(git *sshCommand*)",
      "Bash(git *alias.*)",
      "Bash(git config --global *)",
      "Bash(git config --system *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git remote rename *)",
      "Bash(git remote remove *)",
      "Bash(git remote rm *)",
      "Bash(git tag *)",
      "Bash(git update-ref *refs/tags/*)",
      "Bash(git credential *)",
      "Bash(git credential-osxkeychain *)",
      "Bash(gh auth token *)",
      "Bash(gh auth status -t *)",
      "Bash(gh auth status * -t *)",
      "Bash(gh auth status * -t)",
      "Bash(gh auth status *--show-token*)",
      "Bash(gh auth switch *)",
      "Bash(gh auth login *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth refresh *)",
      "Bash(gh auth setup-git *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh pr ready *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh label create *)",
      "Bash(gh label edit *)",
      "Bash(gh label delete *)",
      "Bash(gh label clone *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh release upload *)",
      "Bash(gh secret *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(gh ruleset create *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)",
      "Bash(gh repo create *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh repo deploy-key *)",
      "Bash(gh alias *)",
      "Bash(gh extension *)",
      "Bash(gh config set *)",
      "Bash(gh cache delete *)",
      "Bash(gh api * -X POST*)",
      "Bash(gh api * -X PUT*)",
      "Bash(gh api * -X PATCH*)",
      "Bash(gh api * -X DELETE*)",
      "Bash(gh api * --method POST*)",
      "Bash(gh api * --method PUT*)",
      "Bash(gh api * --method PATCH*)",
      "Bash(gh api * --method DELETE*)",
      "Bash(gh * --admin*)",
      "Bash(team-gh * --admin*)",
      "Bash(team-gh release *)",
      "Bash(team-gh secret *)",
      "Bash(team-gh variable *)",
      "Bash(team-gh workflow *)",
      "Bash(team-gh ruleset *)",
      "Bash(team-gh repo edit *)",
      "Bash(team-gh auth *)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Bash(security export *)",
      "Bash(team-deploy production *)",
      "Bash(team-flag production *)",
      "Bash(ops/flag production *)",
      "Bash(./ops/flag production *)",
      "Bash(claude -p *)",
      "Bash(claude --print *)",
      "Bash(claude * -p *)",
      "Bash(claude * -p)",
      "Bash(claude *--agent*)",
      "Bash(claude *--settings*)",
      "Bash(claude *--setting-sources*)",
      "Bash(claude *--plugin-dir*)",
      "Bash(claude *--plugin-url*)",
      "Bash(claude *--mcp-config*)",
      "Bash(claude *--add-dir*)",
      "Bash(claude *--bare*)",
      "Bash(claude *--safe-mode*)",
      "Bash(claude *dangerously-skip-permissions*)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(colima stop *)",
      "Bash(colima restart *)",
      "Bash(colima delete *)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(**/.env.production)",
      "Read(**/.env.production.*)",
      "Read(**/*.production.env)",
      "Read(**/production.env)",
      "Read(**/.env.prod)",
      "Edit(~/.claude/**)",
      "Edit(~/.config/team/**)",
      "Edit(**/.git/config)",
      "Edit(**/.git/hooks/**)",
      "mcp__github",
      "mcp__claude_ai_GitHub",
      "Edit(/.claude/settings*.json)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.mcp.json)",
      "Edit(/.claude/worktrees/*/.claude/settings*.json)",
      "Edit(/.claude/worktrees/*/.claude/agents/**)",
      "Edit(/.claude/worktrees/*/.claude/hooks/**)",
      "Edit(/.claude/worktrees/*/.mcp.json)"
    ],
    "ask": [
      "Bash(team-gh pr edit * --add-label owner-approved)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(team-discover *)",
      "Bash(team-provision *)",
      "Bash(team-flag *)",
      "Bash(team-refresh-staging *)",
      "Bash(team-deploy *)",
      "Bash(team-bootstrap-repo *--apply*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/plugin-check",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
